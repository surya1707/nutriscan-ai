[run]
# [FINDING - confirmed by direct testing, not the coverage.py default]
# Without this, coverage.py silently under-reports: it showed app/routers/
# user.py at 51% and app/core/deps.py at 42% even though every line in both
# files is genuinely exercised by this test suite.
#
# Root cause, confirmed by isolating each setting:
#   - greenlet: SQLAlchemy's async engine bridges to its sync DB drivers
#     (aiosqlite here) via greenlet_spawn(). Code that runs inside that
#     greenlet is invisible to coverage.py's default tracer.
#   - thread: app/core/deps.py's get_current_user / get_current_user_optional
#     are plain `def`, not `async def`. FastAPI/Starlette runs sync
#     dependencies in a worker thread (anyio.to_thread.run_sync) so the
#     event loop isn't blocked -- also invisible to the default tracer.
#
# With both enabled, coverage jumped from 84% to an accurate 92% on this
# codebase (verified: app/routers/user.py 51% -> 98%, app/core/deps.py
# 42% -> 95%). Any FastAPI + SQLAlchemy-async project will hit this.
concurrency = greenlet,thread
source = app
