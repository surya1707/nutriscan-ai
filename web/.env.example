# ─────────────────────────────────────────────────────────────
#  NutriScan AI — Web environment variables
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
# FastAPI base URL (no trailing slash).
# Endpoints: /scan/analyse, /scan/barcode, /users/me, /history, /health
VITE_API_URL=http://localhost:8000

# ── Firebase Web SDK ──────────────────────────────────────────
# Keys correspond to FirebaseOptions.web in:
#   mobile/lib/firebase_options.dart.example
#
# Obtain from: Firebase Console → Project Settings → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:yourappid
